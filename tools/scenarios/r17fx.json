{
  "args": ["-level", "L1", "-solution", "-menurect", "-screen-width", "1440", "-screen-height", "900", "-screen-fullscreen", "0"],
  "steps": [
    { "do": "waitlog", "marker": "[level] L1", "timeout": 90 },
    { "do": "wait", "sec": 2.5 },
    { "do": "shot", "name": "before_submit" },

    { "do": "clickrect", "label": "顶栏按钮 提交", "after": 0.6 },
    { "do": "waitlog", "marker": "[fx] SamplePass", "timeout": 60 },
    { "do": "shot", "name": "sample_verdict" },

    { "do": "waitlog", "marker": "[fx] Ac 喷", "timeout": 60 },
    { "do": "shot", "name": "ac_confetti_0" },
    { "do": "wait", "sec": 0.35 },
    { "do": "shot", "name": "ac_confetti_1" },
    { "do": "wait", "sec": 0.6 },
    { "do": "shot", "name": "ac_confetti_2" },
    { "do": "waitlog", "marker": "[sfx] 发声 confetti", "timeout": 20 },

    { "do": "waitlog", "marker": "[submit] L1 pass=", "timeout": 90 },
    { "do": "waitlog", "marker": "[sfx] 发声 ac", "timeout": 30 },
    { "do": "waitlog", "marker": "[fx] LevelClear 喷", "timeout": 90 },
    { "do": "shot", "name": "clear_fireworks_0" },
    { "do": "wait", "sec": 0.4 },
    { "do": "shot", "name": "clear_fireworks_1" },
    { "do": "wait", "sec": 0.7 },
    { "do": "shot", "name": "clear_fireworks_2" },
    { "do": "wait", "sec": 1.2 },
    { "do": "shot", "name": "clear_banner" }
  ]
}
