{
  "args": ["-level", "L1", "-screen-width", "1440", "-screen-height", "900", "-screen-fullscreen", "0"],
  "steps": [
    { "do": "waitlog", "marker": "[level] L1", "timeout": 90 },
    { "do": "wait", "sec": 2.5 },
    { "do": "key", "name": "f9", "after": 0.5 },
    { "do": "waitlog", "marker": "[rectdump] #1", "timeout": 20 },

    { "do": "clickrect", "label": "答案按钮", "after": 1.2 },
    { "do": "waitlog", "marker": "[answer] L1 预览标准答案", "timeout": 20 },
    { "do": "wait", "sec": 1.0 },
    { "do": "key", "name": "f9", "after": 0.5 },
    { "do": "waitlog", "marker": "[rectdump] #2", "timeout": 20 },

    { "do": "clickrect", "label": "答案按钮", "after": 1.2 },
    { "do": "waitlog", "marker": "已退出标准答案预览", "timeout": 15 },
    { "do": "wait", "sec": 2.3 },

    { "do": "key", "name": "f9", "after": 0.5 },
    { "do": "waitlog", "marker": "[rectdump] #3", "timeout": 20 },
    { "do": "click", "at": [0.16, 0.10], "after": 0.5 },
    { "do": "drag", "from": [0.16, 0.10], "to": [0.74, 0.86], "steps": 16, "after": 0.8 },
    { "do": "shot", "name": "after_exit_marquee" },
    { "do": "key", "name": "c", "with": ["ctrl"], "after": 0.6 },
    { "do": "wait", "sec": 1.0 },
    { "do": "shot", "name": "after_exit_copy" }
  ]
}
