{
  "args": ["-level", "P0", "-solution", "-screen-width", "1440", "-screen-height", "900", "-screen-fullscreen", "0"],
  "steps": [
    { "do": "waitlog", "marker": "[level] P0", "timeout": 90 },
    { "do": "wait", "sec": 2.5 },
    { "do": "shot", "name": "bg_p0_base" },

    { "do": "wait", "sec": 2.2 },
    { "do": "shot", "name": "bg_p0_drift" },

    { "do": "drag", "from": [0.60, 0.50], "to": [0.25, 0.50], "button": "middle", "steps": 20, "slice": 0.04, "after": 1.4 },
    { "do": "shot", "name": "bg_p0_pan_x" },

    { "do": "drag", "from": [0.20, 0.75], "to": [0.20, 0.30], "button": "middle", "steps": 20, "slice": 0.04, "after": 1.4 },
    { "do": "shot", "name": "bg_p0_pan_deep" },

    { "do": "drag", "from": [0.20, 0.30], "to": [0.20, 0.80], "button": "middle", "steps": 20, "slice": 0.04, "after": 1.4 },
    { "do": "shot", "name": "bg_p0_pan_shallow" }
  ]
}
