{
  "args": ["-level", "S2", "-cardrect", "-screen-width", "1600", "-screen-height", "1000", "-screen-fullscreen", "0"],
  "steps": [
    { "do": "waitlog", "marker": "[palette] 17 项", "timeout": 60 },
    { "do": "click", "at": [0.30, 0.72], "after": 1.0 },
    { "do": "key", "name": "f9", "after": 0.6 },
    { "do": "waitlog", "marker": "[rectdump] #1", "timeout": 20 },
    { "do": "drag", "label": "模块栏 创建变量", "to": [0.30, 0.62], "steps": 16, "hold": 1.0, "after": 2.0 },
    { "do": "waitlog", "marker": "[drag] 起手 vardecl", "timeout": 20 },
    { "do": "waitlog", "marker": "[add] vardecl", "timeout": 20 },
    { "do": "key", "name": "f9", "after": 0.6 },
    { "do": "waitlog", "marker": "[rectdump] #2", "timeout": 20 },
    { "do": "shot", "name": "add" },
    { "do": "key", "name": "z", "with": ["ctrl"], "after": 0.9 },
    { "do": "waitlog", "marker": "已撤销一步", "timeout": 20 },
    { "do": "key", "name": "f9", "after": 0.6 },
    { "do": "waitlog", "marker": "[rectdump] #3", "timeout": 20 },
    { "do": "shot", "name": "undo" },
    { "do": "key", "name": "y", "with": ["ctrl"], "after": 0.9 },
    { "do": "waitlog", "marker": "已恢复一步", "timeout": 20 },
    { "do": "key", "name": "f9", "after": 0.6 },
    { "do": "waitlog", "marker": "[rectdump] #4", "timeout": 20 },
    { "do": "shot", "name": "redo" },
    { "do": "wait", "sec": 3.0 }
  ]
}
