{
  "args": ["-level", "L1", "-solution", "-screen-width", "1440", "-screen-height", "900", "-screen-fullscreen", "0"],
  "steps": [
    { "do": "waitlog", "marker": "[level] L1", "timeout": 90 },
    { "do": "wait", "sec": 2.5 },
    { "do": "shot", "name": "bg_l1_deep_tint" },

    { "do": "drag", "from": [0.60, 0.50], "to": [0.30, 0.50], "button": "middle", "steps": 20, "slice": 0.04, "after": 1.4 },
    { "do": "shot", "name": "bg_l1_pan_x" }
  ]
}
